# ──────────────────────────────────────────────────────────────
# CLIENT-SIDE (exposed to the browser by Next.js — only PUBLIC values)
# The Supabase anon key is designed to be public; access is controlled by RLS.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key"
NEXT_PUBLIC_SITE_URL="https://admov.io"

# ──────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY (Vercel env vars — NEVER prefix these with NEXT_PUBLIC_)
# ──────────────────────────────────────────────────────────────
# Contact form + blog notifications
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# Supabase service role (bypasses RLS) — used only by cron / approve / admin route handlers
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Daily AI blog generation (OpenAI Responses API). OPENAI_MODEL is optional.
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.6"
# Vercel injects this into the cron request as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET="a-long-random-string"
